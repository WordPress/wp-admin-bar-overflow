<?xml version="1.0"?>
<ruleset name="WP Admin Bar Overflow">
	<description>WordPress Coding Standards for wp-admin-bar-overflow.</description>

	<file>src</file>
	<file>tests</file>
	<file>wp-admin-bar-overflow.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!-- The plugin requires PHP 8.0+, so short array syntax is fine. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Allow modern PHP type declarations on filter callbacks. -->
		<exclude name="WordPress.PHP.DisallowShortTernary"/>
	</rule>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
